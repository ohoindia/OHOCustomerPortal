# API base URL corresponding to CustomerPortal's REACT_APP_BASEURL_NEW.
VITE_API_BASE_URL=http://localhost:3000

# For same-origin local development, set VITE_API_BASE_URL=/ in .env.local.
# Vite forwards /api to this target; use an explicit address if port 3000 is shared.
# VITE_DEV_API_TARGET=http://localhost:3000
