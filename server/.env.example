NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:5173
# Use the existing OHO MySQL database and views; no schema creation is performed.
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
# Legacy OHO datetime columns store India time without an offset.
DB_TIMEZONE=+05:30
DB_SSL=false
# Disabled prevents accidental SMS sends. Use msg91 or smsfresh after configuring credentials.
SMS_PROVIDER=disabled
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
SMSFRESH_OTP_URL=
SMSFRESH_USER=
SMSFRESH_PASSWORD=
SMSFRESH_SENDER=
AWS_REGION=ap-south-1
# Optional onboarding queues, using the AWS default credential chain.
ONBOARDING_SMS_QUEUE_URL=
