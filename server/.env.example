# Use the existing OHO MySQL database and views; no schema creation is performed.
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
# Legacy OHO datetime columns store India time without an offset.
DB_TIMEZONE=+05:30
DB_SSL=false
# Set production to disable Swagger and require an explicit CORS_ORIGINS setting.
NODE_ENV=development
# Optional comma-separated trusted proxy IPs/CIDRs. Leave empty for direct access.
TRUSTED_PROXIES=
# All application settings come from ConfigValues / ConfigSecrets, as in .NET Program.cs.
# JWT_SECRET must be configured in ConfigSecrets, not in this file. See AUTHENTICATION.md.
