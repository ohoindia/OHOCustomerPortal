{
  "expo": {
    "name": "OHOINDIA",
    "slug": "oho-customer-mobile",
    "scheme": "ohoindia",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/oho-brand.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "in.ohoindia.customer"
    },
    "android": {
      "package": "com.ohoindia.connect",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/oho-brand.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/oho-brand.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/oho-brand.png",
          "imageWidth": 150,
          "resizeMode": "contain",
          "backgroundColor": "#0094C6"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow OHOINDIA to find nearby network hospitals."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4b3542d8-7538-453c-b791-fef710a610a6"
      }
    },
    "owner": "reachkarun"
  }
}
